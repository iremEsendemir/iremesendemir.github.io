---
import Section from './Section.astro';
import Gallery from './Gallery.astro';
import Sketch from './Sketch.astro';
import { experience } from '../data/profile';
---

<Section id="experience" eyebrow="01" title="Experience">
  <ol class="timeline pl-8 space-y-14">
    {experience.map((job) => (
      <li class="relative reveal">
        <span class="timeline-dot" aria-hidden="true"></span>
        <div class="grid gap-6 lg:grid-cols-[1fr_minmax(0,1.3fr)] lg:gap-10">
          <div>
            <p class="font-mono text-xs text-ink-faint mb-2">{job.period} · {job.location}</p>
            <h3 class="text-2xl leading-tight">{job.company}</h3>
            <p class="text-ink-soft mt-1">{job.role}</p>
            {job.tags && (
              <div class="mt-4 flex flex-wrap gap-1.5">
                {job.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            )}
            {job.sketch && <Sketch kind={job.sketch} class="mt-6 max-w-[220px]" />}
          </div>
          <div>
            <ul class="space-y-2.5 text-[0.95rem] leading-relaxed text-ink-soft list-disc pl-5 marker:text-lavender">
              {job.bullets.map((b) => <li>{b}</li>)}
            </ul>
            {job.images && (
              <div class="mt-6">
                <Gallery images={job.images} />
              </div>
            )}
          </div>
        </div>
      </li>
    ))}
  </ol>
</Section>
