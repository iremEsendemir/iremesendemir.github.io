---
import Section from './Section.astro';
import { education } from '../data/profile';
---

<Section id="education" eyebrow="04" title="Education">
  <div class="grid gap-6 md:grid-cols-[1.4fr_1fr]">
    {education.map((e) => (
      <article class="card reveal p-6 sm:p-8 flex flex-col">
        <p class="font-mono text-xs text-ink-faint">{e.period} · {e.location}</p>
        <h3 class="text-2xl sm:text-3xl leading-tight mt-2">{e.school}</h3>
        <p class="text-ink-soft mt-1">{e.degree}</p>
        {e.facts && (
          <dl class="mt-6 grid grid-cols-3 gap-x-4 gap-y-4 border-t border-line pt-5">
            {e.facts.map((f) => (
              <div>
                <dt class="eyebrow">{f.label}</dt>
                <dd class="mt-1 font-display text-xl">{f.value}</dd>
              </div>
            ))}
          </dl>
        )}
        {e.note && <p class="text-ink-soft text-[0.95rem] mt-auto pt-5">{e.note}</p>}
      </article>
    ))}
  </div>
</Section>
